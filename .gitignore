# ===========================================================================
# Secrets
# ===========================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ===========================================================================
# Supplied geography source files
# ===========================================================================
# 226 MB of reference data, excluded by size rather than by sensitivity. Their
# SHA-256 checksums are tracked in data/manifests/geography.sha256.json, so
# provenance survives a clone even though the payload does not:
#
#     python scripts/geography_audit.py --verify-only
#
# Listed by exact root-relative path. A broad *.json rule would also exclude
# the OpenAPI contract, the checksum manifest and every package-lock.
/COUNTRY_BOUNDARY.json
/UGANDA_DISTRICT.json
/UGANDA_DISTRICTS.json
/UGANDA_SUBCOUNTIES.json

# Supplied HMIS reference forms. Keep the large source PDFs local and track
# their exact bytes in data/manifests/hmis-reference-documents.sha256.json.
/HMIS 033b HEALTH UNIT WEEKLY EPIDEMIOLOGICAL-ka2024.pdf
/HMIS 105 Health Unit Outpatient Monthly Report-ka2024_IPS.pdf

# Generated geography audit output. Regenerate with scripts/geography_audit.py.
/data/manifests/geography-audit.json

