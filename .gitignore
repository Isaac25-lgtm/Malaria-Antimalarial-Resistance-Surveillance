# Node
# ===========================================================================
node_modules/
.npm/
.eslintcache
*.tsbuildinfo

# Build output. frontend/dist is a build artefact, never committed.
/frontend/dist/
/frontend/.vite/
# Windows occasionally holds a handle on dist/assets, so the build is run
# after renaming the stuck directory aside. Those renames are artefacts too.
/frontend/dist-stuck-*/
/frontend/dist-verify/

# npm debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

