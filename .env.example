# MARS environment configuration.
#
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
#     cp .env.example .env
#
# Every value here is either a safe local-development default or a placeholder.
# No real credential, endpoint or secret belongs in this file.

# ===========================================================================
# Deployment identity
# ===========================================================================

# local | development | staging | production
#
# staging and production are protected: the application refuses to start with
# synthetic authentication or demo mode enabled, and requires an OIDC issuer.
MARS_ENVIRONMENT=local

# Set by the build pipeline. Reported by /api/v1/meta/version so a figure on a
# screen can be traced to the build that produced it.
MARS_RELEASE_VERSION=0.1.0
MARS_GIT_SHA=local
# MARS_BUILD_TIMESTAMP=2026-09-01T00:00:00Z

# ===========================================================================
# Database
# ===========================================================================

# Must name the psycopg (v3) driver explicitly. The application refuses a bare
# postgresql:// URL rather than silently resolving to psycopg2.
#
# Host "postgres" is the Docker Compose service. Outside Compose use localhost
# and the published port (5433 by default, to avoid colliding with a local
# PostgreSQL on 5432).
MARS_DATABASE_URL=postgresql+psycopg://mars:mars_local_development@postgres:5432/mars

MARS_DATABASE_POOL_SIZE=5
MARS_DATABASE_MAX_OVERFLOW=5
MARS_DATABASE_POOL_TIMEOUT_SECONDS=10

# Ceiling on a single statement. Stops a runaway analytical query holding a
# connection indefinitely.
MARS_DATABASE_STATEMENT_TIMEOUT_MS=30000

# Logs every statement. Development diagnostics only - noisy, and a query log
# is not somewhere surveillance content should be written.
MARS_DATABASE_ECHO=false

# Used only by the integration test suite. When unset those tests skip, and the
# skip is reported rather than passing silently.
# MARS_TEST_DATABASE_URL=postgresql+psycopg://mars:mars_local_development@localhost:5433/mars_test

# Identity-vault credentials and cryptographic keys are intentionally omitted.
# Supply them through a secret manager when the identity component is used:
# MARS_IDENTITY_DATABASE_URL=postgresql+psycopg://mars_identity@postgres:5432/mars
# MARS_IDENTITY_LINKAGE_KEY=...
# MARS_IDENTITY_LINKAGE_KEY_VERSION=v1
# MARS_IDENTITY_LINKAGE_RETIRED_KEYS=v0:...
# MARS_IDENTITY_ENCRYPTION_KEY=...
# MARS_IDENTITY_ENCRYPTION_KEY_VERSION=v1
# MARS_IDENTITY_ENCRYPTION_RETIRED_KEYS=v0:...

# ===========================================================================
# Cache and queue
# ===========================================================================
MARS_REDIS_URL=redis://redis:6379/0

# ===========================================================================
# HTTP
# ===========================================================================
MARS_HOST=0.0.0.0
MARS_PORT=8000
MARS_API_V1_PREFIX=/api/v1

# JSON array. Must name the exact origins the web application is served from.
MARS_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Honoured from an inbound request so a trace survives a proxy hop.
MARS_REQUEST_ID_HEADER=X-Request-ID

# ===========================================================================
# Logging
# ===========================================================================
# DEBUG | INFO | WARNING | ERROR | CRITICAL
MARS_LOG_LEVEL=INFO

# json for production log aggregation; console for readable local output.
MARS_LOG_FORMAT=console

# ===========================================================================
# Authentication
# ===========================================================================

# --- Production path: OIDC ---
# Required in staging and production. There is no fallback authentication path.
# MARS_OIDC_ISSUER=https://id.example.org/realms/mars
# MARS_OIDC_CLIENT_ID=mars-web
# MARS_OIDC_AUDIENCE=mars-api
# MARS_OIDC_JWKS_CACHE_SECONDS=3600

# --- Development path: synthetic accounts ---
# Guarded three ways: it must be enabled explicitly, the environment must not be
# protected, and the settings validator refuses the combination outright.
# Every account it issues is flagged synthetic through to the audit trail.
MARS_DEV_AUTH_ENABLED=true

# Signs development tokens only. Never used in a protected environment, so this
# placeholder is not a credential.
MARS_DEV_AUTH_SECRET=local-development-secret-not-for-production

MARS_DEV_AUTH_TOKEN_TTL_SECONDS=28800

# ===========================================================================
# Feature boundaries
# ===========================================================================

# The optional AI assistant. Core surveillance must remain fully functional with
# this disabled, which is why it defaults to off and is out of scope for
# phases 1-2.
MARS_AI_ASSISTANT_ENABLED=false

# When true the interface must visibly mark every screen as carrying synthetic
# data. Refused in staging and production.
MARS_DEMO_MODE_ENABLED=false

# ===========================================================================
# Docker Compose
# ===========================================================================
# Read by docker-compose.yml, not by the application.

POSTGRES_USER=mars
POSTGRES_PASSWORD=mars_local_development
POSTGRES_DB=mars

# Published on loopback only. Non-default ports avoid colliding with a
# PostgreSQL or Redis already running on the host.
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8000
WEB_PORT=5173
