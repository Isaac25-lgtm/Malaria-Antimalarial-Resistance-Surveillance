# MARS web application image.
#
# Two targets: `development` runs the Vite dev server with hot reload;
# `production` builds static assets and serves them from nginx. The API base URL
# stays relative, so one built artefact runs in every environment.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# -- Development ------------------------------------------------------------
FROM deps AS development
WORKDIR /app
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# -- Production build -------------------------------------------------------
FROM deps AS build
WORKDIR /app
COPY . .
RUN npm run build

# -- Production runtime -----------------------------------------------------
FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
