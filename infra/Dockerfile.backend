# MARS backend image: serves both the API and the worker.
#
# One image, two entry points, so the two processes can never drift apart in
# dependency versions - a worker computing an indicator differently from the API
# that serves it would be an invisible and serious defect.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# libpq for psycopg; curl for container health checks.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies are installed before the source is copied, so a source change
# does not invalidate the dependency layer.
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir -e .

COPY alembic.ini ./
COPY migrations ./migrations

# Never run as root.
RUN useradd --create-home --uid 10001 mars \
    && chown -R mars:mars /app
USER mars

EXPOSE 8000

# Overridden per service in docker-compose.yml.
CMD ["uvicorn", "mars.main:app", "--host", "0.0.0.0", "--port", "8000"]
